  "cards": [
    {
      "dot": "cyan",
      "title": "主数据流路径",
      "items": [
        "OPC DA 服务器 → OpcDaClient（COM 订阅）→ DataBridge → Modbus Server → Modbus TCP 客户端 :502",
        "DataTypeConverter 安全转换 DA Variant → Modbus wire type，多字节高 word 在前",
        "Quality 三态传播：Good 写入 / Uncertain 保持旧值 / Bad 标记 BadQuality"
      ]
    },
    {
      "dot": "amber",
      "title": "外部依赖与信任边界",
      "items": [
        "OPC DA 服务器：外部 COM 组件，需 STA 线程模型，运行时不可信",
        "Modbus TCP 0.0.0.0:502：暴露于网络，生产环境需防火墙限定",
        "NModbus 3.x：第三方协议栈，Costura.Fody 嵌入单 EXE",
        "config.json/tags.json：原子写入防断电损坏"
      ]
    },
    {
      "dot": "emerald",
      "title": "支撑组件",
      "items": [
        "GatewayManager：三阶段有序启动，失败回滚，指数退避重连",
        "WatchdogManager：命名事件心跳，看门狗子进程自动重启",
        "ConfigManager：500ms 防抖 + FileSystemWatcher 热重载",
        "LicenseManager：PCID + HMAC-SHA256 离线授权码"
      ]
    }
  ]
}